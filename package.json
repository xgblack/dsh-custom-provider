{
  "name": "dsh-custom-provider",
  "version": "0.1.10",
  "description": "用于 DeepSeek Harness 的模型配置插件，支持管理 llm-pi-ai 提供方、API 凭据、模型发现和单模型配置覆盖。仅提供增强模型配置，不修改官方模型配置页面",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xgblack/dsh-custom-provider.git"
  },
  "bugs": {
    "url": "https://github.com/xgblack/dsh-custom-provider/issues"
  },
  "homepage": "https://github.com/xgblack/dsh-custom-provider#readme",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "docs",
    "!docs/images",
    "lib/profile-registration.js",
    "lib/registration-guard.js",
    "lib/registration-wire.js"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "prepack": "npm run build",
    "test": "npm run build && node test/config.mjs && node test/client.mjs && node --test test/modelsdev.mjs test/render.mjs test/profile-registration.mjs && node --expose-internals --test test/registration-host.mjs",
    "test:config": "node test/config.mjs",
    "test:client": "node test/client.mjs"
  },
  "keywords": ["deepseek-harness", "dsh", "llm", "model-settings", "pi-ai"],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    },
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-config-editor": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-settings": "0.2.1-alpha.3",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-alpha.3",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-app-boot": ">=0.2.1-alpha.3 <0.3.0-0",
    "@deepseek-ai/dsh-atomic-write": ">=0.2.1-alpha.3 <0.3.0-0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-alpha.3 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-app-boot": {
      "optional": true
    },
    "@deepseek-ai/dsh-atomic-write": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    }
  }
}
