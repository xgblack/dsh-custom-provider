{
  "name": "dsh-custom-provider",
  "version": "0.2.0",
  "description": "DeepSeek Harness 官方 Models 页增强插件：models.dev 元数据填充、配置导入导出和单模型 JSON 编辑",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xgblack/dsh-custom-provider.git"
  },
  "bugs": {
    "url": "https://github.com/xgblack/dsh-custom-provider/issues"
  },
  "homepage": "https://github.com/xgblack/dsh-custom-provider#readme",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "docs",
    "!docs/images"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "prepack": "npm run build",
    "test": "npm run build && node --expose-internals --test test/config.mjs test/client.mjs test/modelsdev.mjs test/render.mjs test/host.mjs",
    "test:config": "node --test test/config.mjs",
    "test:client": "node --test test/client.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "llm",
    "model-settings",
    "pi-ai"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-models": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-config-editor": "0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
